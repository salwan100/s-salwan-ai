<!DOCTYPE html>
<html lang="ckb" dir="rtl" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>S-SALWAN2006 AI Universe & Super App</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Google Fonts: Vazirmatn -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f0fdfa',
              500: '#14b8a6',
              600: '#0d9488',
              900: '#134e4a',
            },
            cyanGlow: '#00f3ff',
            goldRoyal: '#ffd700',
            neonPurple: '#a855f7',
            deepBg: '#090d16',
            cardBg: 'rgba(17, 24, 39, 0.7)'
          },
          fontFamily: {
            vazir: ['Vazirmatn', 'sans-serif']
          },
          boxShadow: {
            'glow-cyan': '0 0 20px rgba(0, 243, 255, 0.35)',
            'glow-gold': '0 0 20px rgba(255, 215, 0, 0.35)',
            'glow-purple': '0 0 20px rgba(168, 85, 247, 0.35)',
            'glass': '0 8px 32px 0 rgba(0, 0, 0, 0.37)'
          }
        }
      }
    }
  </script>

  <style>
    * {
      font-family: 'Vazirmatn', sans-serif;
    }
    
    body {
      background-color: #060913;
      color: #f3f4f6;
      overflow-x: hidden;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #090d16;
    }
    ::-webkit-scrollbar-thumb {
      background: #1f2937;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #00f3ff;
    }

    /* Animated Dynamic Mesh Gradient Canvas */
    #mesh-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: -1;
      pointer-events: none;
    }

    /* Glassmorphism Styles */
    .glass-panel {
      background: rgba(15, 23, 42, 0.65);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 1rem;
    }

    .glass-card {
      background: rgba(30, 41, 59, 0.4);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.05);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .glass-card:hover {
      transform: translateY(-4px) scale(1.01);
      border-color: rgba(0, 243, 255, 0.3);
      box-shadow: 0 10px 30px -10px rgba(0, 243, 255, 0.2);
    }

    .neon-border-cyan {
      border: 1px solid rgba(0, 243, 255, 0.4);
      box-shadow: inset 0 0 10px rgba(0, 243, 255, 0.1), 0 0 15px rgba(0, 243, 255, 0.2);
    }

    .neon-border-gold {
      border: 1px solid rgba(255, 215, 0, 0.4);
      box-shadow: inset 0 0 10px rgba(255, 215, 0, 0.1), 0 0 15px rgba(255, 215, 0, 0.2);
    }

    /* Pulsing animations */
    @keyframes pulseGlow {
      0%, 100% { opacity: 0.4; transform: scale(1); }
      50% { opacity: 0.8; transform: scale(1.05); }
    }
    .pulse-glow {
      animation: pulseGlow 4s infinite ease-in-out;
    }

    /* Tab active indicator */
    .nav-item.active {
      background: linear-gradient(90deg, rgba(0, 243, 255, 0.15) 0%, rgba(0, 243, 255, 0) 100%);
      border-right: 4px solid #00f3ff;
      color: #00f3ff;
    }

    /* Custom audio wave visualization bar */
    .wave-bar {
      width: 4px;
      height: 20px;
      background: #00f3ff;
      border-radius: 2px;
      animation: wave 1.2s ease-in-out infinite alternate;
    }
    @keyframes wave {
      0% { height: 6px; }
      100% { height: 36px; }
    }

    /* Theme Overrides */
    .theme-gold {
      --accent-color: #ffd700;
      --accent-glow: rgba(255, 215, 0, 0.3);
    }
    .theme-emerald {
      --accent-color: #10b981;
      --accent-glow: rgba(16, 185, 129, 0.3);
    }
    .theme-cyberpunk {
      --accent-color: #ff007f;
      --accent-glow: rgba(255, 0, 127, 0.3);
    }
  </style>
</head>
<body class="min-h-screen text-slate-100 flex flex-col selection:bg-cyan-500 selection:text-black">

  <!-- BACKGROUND ANIMATED CANVAS -->
  <canvas id="mesh-canvas"></canvas>

  <!-- TOP HEADER GLASSBAR -->
  <header class="sticky top-0 z-40 w-full glass-panel border-b border-slate-800/80 px-4 py-3 flex items-center justify-between shadow-2xl">
    <div class="flex items-center gap-3">
      <!-- Mobile Menu Toggle -->
      <button id="mobileMenuBtn" class="lg:hidden p-2 rounded-lg bg-slate-800/80 text-slate-300 hover:text-white hover:bg-slate-700">
        <i class="fa-solid fa-bars text-lg"></i>
      </button>

      <!-- App Logo -->
      <div class="flex items-center gap-3 cursor-pointer" onclick="switchTab('dashboard')">
        <div class="relative flex items-center justify-center w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-500 via-indigo-600 to-fuchsia-500 p-[2px] shadow-glow-cyan">
          <div class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center">
            <i class="fa-solid fa-brain text-cyan-400 text-xl animate-pulse"></i>
          </div>
        </div>
        <div>
          <h1 class="text-lg font-black tracking-wider bg-gradient-to-r from-cyan-400 via-teal-300 to-indigo-300 bg-clip-text text-transparent">
            S-SALWAN2006 <span class="text-xs px-2 py-0.5 rounded bg-cyan-950/80 text-cyan-400 border border-cyan-500/30">UNIVERSE AI</span>
          </h1>
          <p class="text-[10px] text-slate-400 font-medium">سیستەمی پێشکەوتووی ژیری دەستکردی کوردی</p>
        </div>
      </div>
    </div>

    <!-- Live Status Widgets & Actions -->
    <div class="flex items-center gap-3">
      <!-- Live Voice Assistant Quick Trigger -->
      <button onclick="switchTab('voice-assistant')" class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 hover:bg-cyan-500/20 text-xs font-semibold transition shadow-glow-cyan">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-500"></span>
        </span>
        <i class="fa-solid fa-microphone"></i>
        <span>دەنگی ڕاستەوخۆ</span>
      </button>

      <!-- Token / VIP Status -->
      <div class="hidden md:flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-900/80 border border-amber-500/30 text-amber-400 text-xs font-medium">
        <i class="fa-solid fa-crown text-amber-400"></i>
        <span>ئەندامی VIP Enterprise</span>
      </div>

      <!-- Theme Switcher Dropdown Trigger -->
      <div class="relative">
        <button id="themeBtn" onclick="toggleThemeMenu()" class="p-2.5 rounded-xl glass-card hover:border-cyan-400 text-slate-300 transition">
          <i class="fa-solid fa-palette text-cyan-400"></i>
        </button>
        <!-- Theme Options Menu -->
        <div id="themeMenu" class="hidden absolute left-0 mt-2 w-44 glass-panel border border-slate-700 shadow-2xl rounded-xl p-2 z-50">
          <div class="text-[11px] font-bold text-slate-400 px-2 py-1 mb-1 border-b border-slate-800">هەڵبژاردنی ڕەنگ</div>
          <button onclick="setTheme('default')" class="w-full text-right px-3 py-1.5 rounded-lg text-xs hover:bg-slate-800 flex items-center justify-between text-cyan-400">
            <span>Neon Cyan</span>
            <span class="w-3 h-3 rounded-full bg-cyan-400"></span>
          </button>
          <button onclick="setTheme('gold')" class="w-full text-right px-3 py-1.5 rounded-lg text-xs hover:bg-slate-800 flex items-center justify-between text-amber-400">
            <span>Gold Royal</span>
            <span class="w-3 h-3 rounded-full bg-amber-400"></span>
          </button>
          <button onclick="setTheme('emerald')" class="w-full text-right px-3 py-1.5 rounded-lg text-xs hover:bg-slate-800 flex items-center justify-between text-emerald-400">
            <span>Emerald Nature</span>
            <span class="w-3 h-3 rounded-full bg-emerald-400"></span>
          </button>
          <button onclick="setTheme('cyberpunk')" class="w-full text-right px-3 py-1.5 rounded-lg text-xs hover:bg-slate-800 flex items-center justify-between text-fuchsia-400">
            <span>Deep Cyberpunk</span>
            <span class="w-3 h-3 rounded-full bg-fuchsia-400"></span>
          </button>
        </div>
      </div>

      <!-- Auth Profile Button -->
      <button onclick="openAuthModal()" class="flex items-center gap-2 p-1.5 pr-3 rounded-xl glass-card hover:border-cyan-400/50 transition">
        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&q=80" class="w-7 h-7 rounded-lg object-cover ring-2 ring-cyan-500/50" alt="User">
        <span class="text-xs font-semibold text-slate-200 hidden lg:inline">سەلوان ئەحمەد</span>
      </button>
    </div>
  </header>

  <!-- MAIN WRAPPER WITH PERSISTENT SIDEBAR -->
  <div class="flex-1 flex overflow-hidden">

    <!-- NAVIGATION SIDEBAR -->
    <aside id="sidebar" class="fixed lg:static inset-y-0 right-0 z-30 w-64 glass-panel border-l border-slate-800/80 flex flex-col justify-between transition-transform duration-300 transform translate-x-full lg:translate-x-0 pt-16 lg:pt-0">
      
      <div class="p-4 space-y-6 overflow-y-auto max-h-[calc(100vh-80px)]">
        <!-- Main Navigation Links -->
        <div>
          <div class="text-[11px] font-bold text-slate-500 uppercase tracking-wider px-3 mb-2">بەشە سەرەکییەکان</div>
          <nav class="space-y-1">
            <button onclick="switchTab('dashboard')" id="nav-dashboard" class="nav-item active w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition text-slate-300 hover:bg-slate-800/50">
              <i class="fa-solid fa-house w-5 text-center text-cyan-400"></i>
              <span>داشبۆردی سەرەکی</span>
            </button>
            <button onclick="switchTab('voice-assistant')" id="nav-voice-assistant" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition text-slate-300 hover:bg-slate-800/50">
              <i class="fa-solid fa-microphone-lines w-5 text-center text-cyan-400"></i>
              <span>سیستەمی دەنگی S-SALWAN</span>
            </button>
            <button onclick="switchTab('qa-community')" id="nav-qa-community" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition text-slate-300 hover:bg-slate-800/50">
              <i class="fa-solid fa-comments w-5 text-center text-cyan-400"></i>
              <span>پرس و وەڵامی ڕاستەوخۆ</span>
            </button>
            <button onclick="switchTab('smart-search')" id="nav-smart-search" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition text-slate-300 hover:bg-slate-800/50">
              <i class="fa-solid fa-magnifying-glass-chart w-5 text-center text-cyan-400"></i>
              <span>گەڕانی زیرەکی AI</span>
            </button>
          </nav>
        </div>

        <!-- Media & Creativity -->
        <div>
          <div class="text-[11px] font-bold text-slate-500 uppercase tracking-wider px-3 mb-2">میدیا و داهێنان</div>
          <nav class="space-y-1">
            <button onclick="switchTab('gallery')" id="nav-gallery" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition text-slate-300 hover:bg-slate-800/50">
              <i class="fa-solid fa-images w-5 text-center text-emerald-400"></i>
              <span>گالێریی Ultra-HD</span>
            </button>
            <button onclick="switchTab('ai-studio')" id="nav-ai-studio" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition text-slate-300 hover:bg-slate-800/50">
              <i class="fa-solid fa-wand-magic-sparkles w-5 text-center text-fuchsia-400"></i>
              <span>تاقیگەی وێنەی AI</span>
            </button>
            <button onclick="switchTab('kurdish-culture')" id="nav-kurdish-culture" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition text-slate-300 hover:bg-slate-800/50">
              <i class="fa-solid fa-book-open-reader w-5 text-center text-amber-400"></i>
              <span>هۆنراوە و کەلتوری کوردی</span>
            </button>
          </nav>
        </div>

        <!-- Account & Analytics -->
        <div>
          <div class="text-[11px] font-bold text-slate-500 uppercase tracking-wider px-3 mb-2">ئەکاونت و ئامار</div>
          <nav class="space-y-1">
            <button onclick="switchTab('analytics')" id="nav-analytics" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition text-slate-300 hover:bg-slate-800/50">
              <i class="fa-solid fa-chart-line w-5 text-center text-blue-400"></i>
              <span>داشبۆردی ئامارەکان</span>
            </button>
            <button onclick="switchTab('profile')" id="nav-profile" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition text-slate-300 hover:bg-slate-800/50">
              <i class="fa-solid fa-user-gear w-5 text-center text-violet-400"></i>
              <span>پڕۆفایلی بەکارهێنەر</span>
            </button>
          </nav>
        </div>
      </div>

      <!-- Sidebar Footer Mini Widget -->
      <div class="p-4 border-t border-slate-800/80 bg-slate-950/40">
        <div class="flex items-center justify-between text-xs text-slate-400 mb-2">
          <span>دۆخی ڕاژەکاری AI:</span>
          <span class="text-emerald-400 flex items-center gap-1 font-bold">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span> چالاکە
          </span>
        </div>
        <div class="w-full bg-slate-800 rounded-full h-1.5 overflow-hidden">
          <div class="bg-gradient-to-r from-cyan-500 to-indigo-500 h-1.5 rounded-full w-[88%]"></div>
        </div>
        <div class="text-[10px] text-slate-500 mt-1 text-center">وەشانی سیستەم v4.8 Enterprise</div>
      </div>
    </aside>

    <!-- CONTENT DISPLAY AREA -->
    <main class="flex-1 overflow-y-auto p-4 md:p-6 lg:p-8 space-y-8 relative">

      <!-- ================= 1. DASHBOARD OVERVIEW TAB ================= -->
      <section id="tab-dashboard" class="tab-content space-y-6">
        <!-- Hero Banner -->
        <div class="relative overflow-hidden rounded-2xl glass-panel p-6 md:p-8 neon-border-cyan">
          <div class="absolute -top-24 -left-24 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
          <div class="relative z-10 max-w-3xl space-y-4">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-xs font-semibold">
              <i class="fa-solid fa-sparkles"></i> سەکۆی گشتگیری S-SALWAN2006 Super App
            </div>
            <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight text-white leading-tight">
              بەخێربێیت بۆ تاقانەترین <span class="bg-gradient-to-r from-cyan-400 via-teal-300 to-amber-300 bg-clip-text text-transparent">گەردوونی ژیری دەستکرد</span>
            </h2>
            <p class="text-slate-300 text-sm md:text-base leading-relaxed">
              سەکۆیەکی بەهێز بۆ ئەنجامدانی گفتوگۆی دەنگی ڕاستەوخۆ بە زمانی کوردی، شیکاری گەڕانی قووڵ، دروستکردنی وێنەی کواڵتی بەرز، پرس و وەڵامی زانستی، و دەیان بەشی ناوازە.
            </p>

            <div class="flex flex-wrap gap-3 pt-2">
              <button onclick="switchTab('voice-assistant')" class="px-5 py-3 rounded-xl bg-gradient-to-r from-cyan-500 to-indigo-600 font-bold text-sm text-white shadow-glow-cyan hover:opacity-90 transition flex items-center gap-2">
                <i class="fa-solid fa-microphone-lines"></i>
                <span>دەستپێکردنی ئاخاوتنی دەنگی</span>
              </button>
              <button onclick="switchTab('gallery')" class="px-5 py-3 rounded-xl glass-card text-sm font-bold text-slate-200 hover:border-cyan-400 transition flex items-center gap-2">
                <i class="fa-solid fa-compass text-cyan-400"></i>
                <span>گەڕان لە گالێری Ultra-HD</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Quick Stats Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="glass-card p-5 rounded-2xl flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 text-xl">
              <i class="fa-solid fa-bolt"></i>
            </div>
            <div>
              <div class="text-2xl font-black text-white">99.8%</div>
              <div class="text-xs text-slate-400 font-medium">دروستی ئاخاوتنی کوردی</div>
            </div>
          </div>

          <div class="glass-card p-5 rounded-2xl flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 text-xl">
              <i class="fa-solid fa-users"></i>
            </div>
            <div>
              <div class="text-2xl font-black text-white">45,280+</div>
              <div class="text-xs text-slate-400 font-medium">بەکارهێنەری چالاک</div>
            </div>
          </div>

          <div class="glass-card p-5 rounded-2xl flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-fuchsia-500/10 border border-fuchsia-500/30 flex items-center justify-center text-fuchsia-400 text-xl">
              <i class="fa-solid fa-image"></i>
            </div>
            <div>
              <div class="text-2xl font-black text-white">120,000+</div>
              <div class="text-xs text-slate-400 font-medium">وێنەی دروستکراوی AI</div>
            </div>
          </div>

          <div class="glass-card p-5 rounded-2xl flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 text-xl">
              <i class="fa-solid fa-waveform"></i>
            </div>
            <div>
              <div class="text-2xl font-black text-white">0.25s</div>
              <div class="text-xs text-slate-400 font-medium">خێرایی وەڵامدانەوەی دەنگ</div>
            </div>
          </div>
        </div>

        <!-- Featured Modules Overview -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Voice Suite Card -->
          <div class="glass-card p-6 rounded-2xl space-y-4 relative overflow-hidden group">
            <div class="w-10 h-10 rounded-lg bg-cyan-500/20 text-cyan-300 flex items-center justify-center text-lg font-bold">01</div>
            <h3 class="text-xl font-bold text-white group-hover:text-cyan-400 transition">سیستەمی دەنگی ژیری دەستکرد</h3>
            <p class="text-xs text-slate-400 leading-relaxed">دەتوانیت بە دەنگ ڕاستەوخۆ قسە لەگەڵ AI بوبکەیت و وەڵامی دەنگی هەنووکەیی لەگەڵ لەرەلەری دەنگ وەربگریتەوە.</p>
            <button onclick="switchTab('voice-assistant')" class="text-xs font-bold text-cyan-400 flex items-center gap-2 hover:underline">
              تاقیکردنەوەی ئێستا <i class="fa-solid fa-arrow-left"></i>
            </button>
          </div>

          <!-- Q&A Hub Card -->
          <div class="glass-card p-6 rounded-2xl space-y-4 relative overflow-hidden group">
            <div class="w-10 h-10 rounded-lg bg-amber-500/20 text-amber-300 flex items-center justify-center text-lg font-bold">02</div>
            <h3 class="text-xl font-bold text-white group-hover:text-amber-400 transition">پرس و وەڵامی کۆمەڵگە</h3>
            <p class="text-xs text-slate-400 leading-relaxed">پرس و وەڵامی ڕاستەوخۆ لە هەموو بوارەکان لەگەڵ وەڵامدانەوەی پچڕنەنەبووی شارەزایانی AI.</p>
            <button onclick="switchTab('qa-community')" class="text-xs font-bold text-amber-400 flex items-center gap-2 hover:underline">
              چوون بۆ پرس و وەڵام <i class="fa-solid fa-arrow-left"></i>
            </button>
          </div>

          <!-- Gallery Card -->
          <div class="glass-card p-6 rounded-2xl space-y-4 relative overflow-hidden group">
            <div class="w-10 h-10 rounded-lg bg-emerald-500/20 text-emerald-300 flex items-center justify-center text-lg font-bold">03</div>
            <h3 class="text-xl font-bold text-white group-hover:text-emerald-400 transition">گالێریی فرە-چەشنی Ultra HD</h3>
            <p class="text-xs text-slate-400 leading-relaxed">سەدان وێنەی تایبەت بە ئۆتۆمبێلی خێرا، مرۆڤ و کەلتوری کوردی، سروشت و دار، و گەردوون.</p>
            <button onclick="switchTab('gallery')" class="text-xs font-bold text-emerald-400 flex items-center gap-2 hover:underline">
              بینینی گالێری <i class="fa-solid fa-arrow-left"></i>
            </button>
          </div>
        </div>
      </section>


      <!-- ================= 2. REAL-TIME AI VOICE ASSISTANT TAB ================= -->
      <section id="tab-voice-assistant" class="tab-content hidden space-y-6">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 glass-panel p-6 rounded-2xl">
          <div>
            <h2 class="text-2xl font-bold text-white flex items-center gap-2">
              <i class="fa-solid fa-microphone-lines text-cyan-400"></i>
              S-SALWAN2006 Real-Time Voice AI
            </h2>
            <p class="text-xs text-slate-400 mt-1">ئاخاوتنی ڕاستەوخۆ بە دەنگ بە زمانەکانی کوردی سورانی، عەرەبی و ئینگلیزی</p>
          </div>

          <!-- Model Switcher -->
          <div class="flex items-center gap-2 bg-slate-900/80 p-1.5 rounded-xl border border-slate-700">
            <span class="text-xs font-semibold px-2 text-slate-400">مۆدێل:</span>
            <select id="voiceModelSelect" class="bg-slate-800 text-xs text-cyan-300 font-bold px-3 py-1.5 rounded-lg border-none focus:ring-1 focus:ring-cyan-400 outline-none">
              <option value="S-SALWAN Turbo">S-SALWAN2006 Turbo (خێرا)</option>
              <option value="S-SALWAN Vision">S-SALWAN2006 Vision Pro</option>
              <option value="S-SALWAN Audio Pro" selected>S-SALWAN2006 Audio Pro (دەنگی باڵا)</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <!-- Voice Visualization Canvas Panel -->
          <div class="lg:col-span-2 glass-panel p-6 rounded-2xl flex flex-col items-center justify-between min-h-[420px] relative overflow-hidden">
            <!-- Background Glow -->
            <div id="voiceGlowBg" class="absolute w-72 h-72 rounded-full bg-cyan-500/10 blur-3xl transition-all duration-500"></div>

            <!-- Header Status -->
            <div class="w-full flex items-center justify-between z-10">
              <div id="voiceStatusBadge" class="px-3 py-1 rounded-full bg-slate-800 border border-slate-700 text-xs text-slate-300 flex items-center gap-2">
                <span id="voiceStatusDot" class="w-2.5 h-2.5 rounded-full bg-slate-500"></span>
                <span id="voiceStatusText">ئامادەیە بۆ گوێگرتن</span>
              </div>
              <div class="text-xs text-slate-400 flex items-center gap-3">
                <span class="flex items-center gap-1"><i class="fa-solid fa-gauge text-cyan-400"></i> Latency: 18ms</span>
              </div>
            </div>

            <!-- Dynamic Live Audio Waves Canvas -->
            <div class="my-8 w-full flex flex-col items-center justify-center z-10">
              <canvas id="voiceWaveCanvas" class="w-full h-32 max-w-lg mb-4"></canvas>
              <div id="listeningPrompt" class="text-sm font-semibold text-cyan-300/80 text-center animate-pulse">
                کلیک لەسەر میکڕۆفۆنەکە بکه و بە دەنگ قسە بکە...
              </div>
            </div>

            <!-- Big Interactive Microphone Button -->
            <div class="z-10 flex flex-col items-center gap-4">
              <button id="micToggleBtn" onclick="toggleVoiceRecognition()" class="w-20 h-20 rounded-full bg-gradient-to-tr from-cyan-500 via-indigo-600 to-fuchsia-600 p-1 shadow-glow-cyan hover:scale-105 transition-transform duration-300 flex items-center justify-center group">
                <div class="w-full h-full rounded-full bg-slate-950 flex items-center justify-center text-cyan-400 text-2xl group-hover:text-white">
                  <i id="micIcon" class="fa-solid fa-microphone"></i>
                </div>
              </button>
              <span class="text-xs text-slate-400">کۆنترۆڵی دەنگ بە کارایی دەستبەجێ</span>
            </div>
          </div>

          <!-- Controls & Voice Settings Sidebar -->
          <div class="glass-panel p-6 rounded-2xl space-y-6">
            <h3 class="text-lg font-bold text-white border-b border-slate-800 pb-3 flex items-center gap-2">
              <i class="fa-solid fa-sliders text-cyan-400"></i>
              ڕێکخستنەکانی دەنگ
            </h3>

            <!-- Language Switcher -->
            <div class="space-y-2">
              <label class="text-xs font-semibold text-slate-300">زمانی گفتوگۆ:</label>
              <select id="voiceLangSelect" class="w-full bg-slate-900 border border-slate-700 text-xs text-slate-200 rounded-xl p-2.5 focus:border-cyan-400 outline-none">
                <option value="ckb-IQ" selected>کوردی (سورانی) - Kurdish</option>
                <option value="ar-IQ">عەرەبی - Arabic</option>
                <option value="en-US">ئینگلیزی - English</option>
              </select>
            </div>

            <!-- Voice Speed Controller -->
            <div class="space-y-2">
              <div class="flex justify-between text-xs text-slate-300">
                <span>خێرایی ئاخاوتن (Speed):</span>
                <span id="speedValue" class="text-cyan-400 font-bold">1.0x</span>
              </div>
              <input type="range" id="speechRate" min="0.5" max="2" step="0.1" value="1.0" oninput="document.getElementById('speedValue').innerText = this.value + 'x'" class="w-full accent-cyan-400 bg-slate-800 rounded-lg h-2">
            </div>

            <!-- Pitch Controller -->
            <div class="space-y-2">
              <div class="flex justify-between text-xs text-slate-300">
                <span>پۆست و لەرەلەر (Pitch):</span>
                <span id="pitchValue" class="text-cyan-400 font-bold">1.0</span>
              </div>
              <input type="range" id="speechPitch" min="0.5" max="1.5" step="0.1" value="1.0" oninput="document.getElementById('pitchValue').innerText = this.value" class="w-full accent-cyan-400 bg-slate-800 rounded-lg h-2">
            </div>

            <!-- Auto-Speak AI Toggle -->
            <div class="flex items-center justify-between p-3 rounded-xl bg-slate-900/60 border border-slate-800">
              <span class="text-xs font-semibold text-slate-300">وەڵامدانەوەی دەنگی خێرا</span>
              <input type="checkbox" id="autoSpeakToggle" checked class="w-4 h-4 accent-cyan-400 rounded">
            </div>

            <!-- Quick Voice Test Button -->
            <button onclick="speakText('بەخێربێیت بۆ سستەمی دەنگی سەلوان ئێ ئای. هەموو شتێک بۆ خزمەتی تۆ ئامادەیە.')" class="w-full py-2.5 rounded-xl border border-cyan-500/30 text-cyan-300 text-xs font-bold hover:bg-cyan-500/10 transition flex items-center justify-center gap-2">
              <i class="fa-solid fa-volume-high"></i>
              تاقیکردنەوەی دەنگی AI
            </button>
          </div>
        </div>

        <!-- Real-time Voice Chat Log -->
        <div class="glass-panel p-6 rounded-2xl space-y-4">
          <h3 class="text-base font-bold text-white flex items-center justify-between">
            <span>تۆماری گفتوگۆی دەنگی ڕاستەوخۆ</span>
            <button onclick="clearVoiceLog()" class="text-xs font-normal text-slate-400 hover:text-rose-400">سڕینەوەی لۆگ</button>
          </h3>
          <div id="voiceChatLog" class="space-y-3 max-h-64 overflow-y-auto p-3 bg-slate-950/50 rounded-xl border border-slate-800 text-xs">
            <div class="p-2.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300">
              <span class="font-bold text-cyan-400">S-SALWAN AI:</span> بەخێربێیت! میکڕۆفۆنەکە دابگرە بۆ دەستپێکردنی قسەکردن بە زمانی کوردی.
            </div>
          </div>
        </div>
      </section>


      <!-- ================= 3. COMMUNITY LIVE Q&A TAB ================= -->
      <section id="tab-qa-community" class="tab-content hidden space-y-6">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 glass-panel p-6 rounded-2xl">
          <div>
            <h2 class="text-2xl font-bold text-white flex items-center gap-2">
              <i class="fa-solid fa-comments text-amber-400"></i>
              پرس و وەڵامی ڕاستەوخۆ (Live Community Q&A)
            </h2>
            <p class="text-xs text-slate-400 mt-1">پرسیار بکە و لەگەڵ بەکارهێنەران و AI سەلوان وەڵامی دەستبەجێ وەربگرە</p>
          </div>
          <button onclick="openAskQuestionModal()" class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-orange-600 font-bold text-xs text-white shadow-glow-gold hover:opacity-90 transition flex items-center gap-2">
            <i class="fa-solid fa-plus"></i>
            زیادکردنی پرسیاری نوێ
          </button>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
          <!-- Main Questions Feed -->
          <div class="lg:col-span-3 space-y-4" id="questionsContainer">
            <!-- Questions rendered via Javascript -->
          </div>

          <!-- Community Stats & Top Contributors -->
          <div class="space-y-4">
            <div class="glass-panel p-5 rounded-2xl space-y-4">
              <h3 class="text-sm font-bold text-white border-b border-slate-800 pb-2">چالاکی زیندووی کۆمەڵگە</h3>
              <div class="space-y-3 text-xs">
                <div class="flex justify-between text-slate-300">
                  <span>پرسیارە وەڵامدراوەکان:</span>
                  <span class="text-emerald-400 font-bold">98.4%</span>
                </div>
                <div class="flex justify-between text-slate-300">
                  <span>تێکڕای خێرایی وەڵام:</span>
                  <span class="text-cyan-400 font-bold">4 چڕکە</span>
                </div>
                <div class="flex justify-between text-slate-300">
                  <span>کەسی سەرهێڵ:</span>
                  <span class="text-amber-400 font-bold flex items-center gap-1">
                    <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span> 1,240
                  </span>
                </div>
              </div>
            </div>

            <!-- Top AI Experts -->
            <div class="glass-panel p-5 rounded-2xl space-y-3">
              <h3 class="text-sm font-bold text-white border-b border-slate-800 pb-2">سەرکردەکانی وەڵامدانەوە</h3>
              <div class="space-y-2 text-xs">
                <div class="flex items-center gap-2 p-1.5 rounded-lg bg-slate-900/60">
                  <span class="w-5 font-bold text-amber-400">1</span>
                  <img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=80&q=80" class="w-7 h-7 rounded-full" alt="User">
                  <div class="flex-1">
                    <div class="font-bold text-slate-200">د. پشتیوان شێخ</div>
                    <div class="text-[10px] text-slate-400">4,210 points</div>
                  </div>
                </div>
                <div class="flex items-center gap-2 p-1.5 rounded-lg bg-slate-900/60">
                  <span class="w-5 font-bold text-slate-300">2</span>
                  <img src="https://images.unsplash.com/photo-1570295999919-56ceb5ecca61?auto=format&fit=crop&w=80&q=80" class="w-7 h-7 rounded-full" alt="User">
                  <div class="flex-1">
                    <div class="font-bold text-slate-200">S-SALWAN Bot</div>
                    <div class="text-[10px] text-slate-400">3,980 points</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>


      <!-- ================= 4. ULTRA-HD MULTI-CATEGORY GALLERY TAB ================= -->
      <section id="tab-gallery" class="tab-content hidden space-y-6">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 glass-panel p-6 rounded-2xl">
          <div>
            <h2 class="text-2xl font-bold text-white flex items-center gap-2">
              <i class="fa-solid fa-images text-emerald-400"></i>
              گالێریی وێنەی Ultra-HD
            </h2>
            <p class="text-xs text-slate-400 mt-1">ئۆتۆمبێلە سوپەرەکان، مرۆڤ و کەلتور، سروشت و دار، و گەردوون</p>
          </div>

          <!-- Category Filters -->
          <div class="flex flex-wrap gap-2" id="galleryFilterContainer">
            <button onclick="filterGallery('all')" class="gallery-filter-btn px-3 py-1.5 rounded-xl bg-emerald-500 text-slate-950 font-bold text-xs shadow-glow-emerald">هەمووی</button>
            <button onclick="filterGallery('cars')" class="gallery-filter-btn px-3 py-1.5 rounded-xl glass-card text-xs text-slate-300 hover:text-emerald-400">ئۆتۆمبێلی خێرا</button>
            <button onclick="filterGallery('culture')" class="gallery-filter-btn px-3 py-1.5 rounded-xl glass-card text-xs text-slate-300 hover:text-emerald-400">مرۆڤ و کەلتور</button>
            <button onclick="filterGallery('nature')" class="gallery-filter-btn px-3 py-1.5 rounded-xl glass-card text-xs text-slate-300 hover:text-emerald-400">دار و سروشت</button>
            <button onclick="filterGallery('space')" class="gallery-filter-btn px-3 py-1.5 rounded-xl glass-card text-xs text-slate-300 hover:text-emerald-400">گەردوون و زانست</button>
          </div>
        </div>

        <!-- Gallery Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4" id="galleryGrid">
          <!-- Gallery Cards injected via JS -->
        </div>
      </section>


      <!-- ================= 5. SMART SEARCH ENGINE TAB ================= -->
      <section id="tab-smart-search" class="tab-content hidden space-y-6">
        <div class="max-w-3xl mx-auto space-y-6 text-center">
          <div class="space-y-2">
            <h2 class="text-3xl font-extrabold text-white">بزوێنەری گەڕانی زیرەکی AI</h2>
            <p class="text-xs text-slate-400">گەڕانی قووڵ لە زانیارییەکان بە پێشاندانی وەڵامی کورتی کورتکراوە و Knowledge Graph</p>
          </div>

          <!-- Big Search Bar -->
          <div class="relative">
            <input type="text" id="searchInput" placeholder="دەربارەی چی دەتەوێت بزانیت؟ (نموونە: هۆشەنگ سۆسیال، زانستی فیزیا، سیستەمی بزوێنەر)..." class="w-full py-4 pl-12 pr-12 rounded-2xl glass-panel text-sm text-white placeholder-slate-500 border border-slate-700 focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/20 outline-none shadow-2xl">
            <button onclick="performSearch()" class="absolute left-3 top-1/2 -translate-y-1/2 px-4 py-2 rounded-xl bg-cyan-500 text-slate-950 font-bold text-xs hover:bg-cyan-400 transition">
              گەڕان <i class="fa-solid fa-magnifying-glass"></i>
            </button>
          </div>

          <!-- Suggested Query Pills -->
          <div class="flex flex-wrap justify-center gap-2 text-xs">
            <span class="text-slate-500 font-semibold self-center">پێشنیارکراوەکان:</span>
            <button onclick="quickSearch('ژیری دەستکرد چییە؟')" class="px-3 py-1 rounded-full glass-card hover:border-cyan-400 text-slate-300">ژیری دەستکرد چییە؟</button>
            <button onclick="quickSearch('تەکنەلۆجیای ئۆتۆمبێلی کارەبایی')" class="px-3 py-1 rounded-full glass-card hover:border-cyan-400 text-slate-300">ئۆتۆمبێلی کارەبایی</button>
            <button onclick="quickSearch('مێژووی کورد و کەلتور')" class="px-3 py-1 rounded-full glass-card hover:border-cyan-400 text-slate-300">مێژووی کورد</button>
          </div>
        </div>

        <!-- Search Results Container -->
        <div id="searchResultsArea" class="max-w-4xl mx-auto space-y-4 hidden">
          <!-- Live Answer Summary Card -->
          <div class="glass-panel p-6 rounded-2xl border-r-4 border-cyan-400 space-y-3">
            <div class="flex items-center gap-2 text-cyan-400 font-bold text-xs">
              <i class="fa-solid fa-robot"></i> کورتکراوەی AI
            </div>
            <p id="searchSummaryText" class="text-sm text-slate-200 leading-relaxed"></p>
          </div>

          <!-- Knowledge Cards Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="searchCardsGrid">
            <!-- Injected via JS -->
          </div>
        </div>
      </section>


      <!-- ================= 6. AI IMAGE STUDIO TAB ================= -->
      <section id="tab-ai-studio" class="tab-content hidden space-y-6">
        <div class="glass-panel p-6 rounded-2xl flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
          <div>
            <h2 class="text-2xl font-bold text-white flex items-center gap-2">
              <i class="fa-solid fa-wand-magic-sparkles text-fuchsia-400"></i>
              تاقیگەی دروستکردنی وێنەی AI (Studio)
            </h2>
            <p class="text-xs text-slate-400 mt-1">دەق بنووسە بۆ دروستکردنی وێنەی مێشکبڕ و کواڵتی نائاسایی</p>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <!-- Prompt Config Form -->
          <div class="glass-panel p-6 rounded-2xl space-y-4">
            <div class="space-y-2">
              <label class="text-xs font-semibold text-slate-300">وەسفی وێنەکە (Prompt):</label>
              <textarea id="imagePromptInput" rows="4" placeholder="نموونە: وێنەیەکی خەیاڵی بۆ ئۆتۆمبێلێکی نوێ لە ئاسۆیەکی سایبەرپانک لەگەڵ ڕووناکی شین..." class="w-full bg-slate-900 border border-slate-700 text-xs text-slate-200 rounded-xl p-3 focus:border-fuchsia-400 outline-none"></textarea>
            </div>

            <div class="space-y-2">
              <label class="text-xs font-semibold text-slate-300">ستایلی وێنە:</label>
              <select id="imageStyleSelect" class="w-full bg-slate-900 border border-slate-700 text-xs text-slate-200 rounded-xl p-2.5 focus:border-fuchsia-400 outline-none">
                <option value="Cyberpunk Sci-Fi">سایبەرپانک Sci-Fi</option>
                <option value="Photorealistic 8K" selected>واقیعی Photorealistic 8K</option>
                <option value="Kurdish Traditional Art">هونەری کەلتوری کوردی</option>
                <option value="3D Anime Render">ڕێندەری 3D ئانیمێ</option>
              </select>
            </div>

            <button onclick="generateAIStudioImage()" class="w-full py-3 rounded-xl bg-gradient-to-r from-fuchsia-600 to-pink-600 font-bold text-xs text-white shadow-glow-purple hover:opacity-90 transition flex items-center justify-center gap-2">
              <i class="fa-solid fa-paint-brush"></i>
              دروستکردنی وێنە
            </button>
          </div>

          <!-- Result Preview Panel -->
          <div class="lg:col-span-2 glass-panel p-6 rounded-2xl flex flex-col items-center justify-center min-h-[350px] relative">
            <div id="imageStudioPlaceholder" class="text-center space-y-3">
              <i class="fa-regular fa-image text-4xl text-slate-600"></i>
              <p class="text-xs text-slate-400">وەسفی وێنەکەت بنووسە و دوگمەی دروستکردن دابگرە</p>
            </div>

            <div id="imageStudioLoading" class="hidden flex-col items-center gap-3">
              <div class="w-10 h-10 border-4 border-fuchsia-500 border-t-transparent rounded-full animate-spin"></div>
              <span class="text-xs font-semibold text-fuchsia-300">دروستکردنی وێنە لە ڕێگەی S-SALWAN Vision...</span>
            </div>

            <div id="imageStudioResult" class="hidden w-full h-full space-y-3">
              <img id="generatedImageTag" src="" class="w-full h-80 object-cover rounded-xl border border-slate-700" alt="Generated AI">
              <div class="flex items-center justify-between">
                <span class="text-xs text-slate-400">کواڵتی: 4K UHD</span>
                <button onclick="downloadStudioImage()" class="px-4 py-1.5 rounded-lg bg-slate-800 text-xs text-cyan-400 hover:bg-slate-700 border border-slate-700 flex items-center gap-2">
                  <i class="fa-solid fa-download"></i> داگرتنی وێنە
                </button>
              </div>
            </div>
          </div>
        </div>
      </section>


