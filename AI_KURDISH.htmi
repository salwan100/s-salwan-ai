      <!-- ================= 8. ANALYTICS DASHBOARD TAB ================= -->
      <section id="tab-analytics" class="tab-content hidden space-y-6">
        <div class="glass-panel p-6 rounded-2xl">
          <h2 class="text-2xl font-bold text-white flex items-center gap-2">
            <i class="fa-solid fa-chart-line text-blue-400"></i>
            داشبۆردی ئامارەکان (Real-Time Analytics)
          </h2>
          <p class="text-xs text-slate-400 mt-1">ترافیکی سەردانکەران، ڕێژەی داواکاری AI، و دانیشتنە دەنگییەکان</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div class="glass-panel p-6 rounded-2xl space-y-4">
            <h3 class="text-sm font-bold text-white">ترافیکی ڕۆژانەی بەکارهێنەران</h3>
            <canvas id="trafficChart" class="w-full h-64"></canvas>
