  <!-- ================= JAVASCRIPT CODE ENGINE ================= -->
  <script>
    /* ----------------------------------------------------
       1. ANIMATED MESH GRADIENT CANVAS BACKGROUND
    ---------------------------------------------------- */
    const canvas = document.getElementById('mesh-canvas');
    const ctx = canvas.getContext('2d');
    let width, height;
    let particles = [];

    function resizeCanvas() {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    class Particle {
      constructor() {
        this.x = Math.random() * width;
        this.y = Math.random() * height;
        this.radius = Math.random() * 150 + 50;
        this.vx = (Math.random() - 0.5) * 0.5;
        this.vy = (Math.random() - 0.5) * 0.5;
        this.color = ['rgba(0, 243, 255, 0.08)', 'rgba(168, 85, 247, 0.08)', 'rgba(255, 215, 0, 0.05)'][Math.floor(Math.random() * 3)];
      }
      update() {
        this.x += this.vx;
        this.y += this.vy;
        if (this.x < -100) this.x = width + 100;
        if (this.x > width + 100) this.x = -100;
        if (this.y < -100) this.y = height + 100;
        if (this.y > height + 100) this.y = -100;
      }
      draw() {
        ctx.beginPath();
        let grad = ctx.createRadialGradient(this.x, this.y, 0, this.x, this.y, this.radius);
        grad.addColorStop(0, this.color);
        grad.addColorStop(1, 'transparent');
        ctx.fillStyle = grad;
        ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    for (let i = 0; i < 15; i++) {
      particles.push(new Particle());
    }

    function animateMesh() {
      ctx.clearRect(0, 0, width, height);
      particles.forEach(p => {
        p.update();
        p.draw();
      });
      requestAnimationFrame(animateMesh);
    }
    animateMesh();


    /* ----------------------------------------------------
       2. TAB NAVIGATION & MOBILE SIDEBAR CONTROL
    ---------------------------------------------------- */
    function switchTab(tabId) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));

      const selectedTab = document.getElementById('tab-' + tabId);
      const selectedNav = document.getElementById('nav-' + tabId);

      if (selectedTab) selectedTab.classList.remove('hidden');
      if (selectedNav) selectedNav.classList.add('active');

      // Close mobile sidebar if open
      const sidebar = document.getElementById('sidebar');
      if (!sidebar.classList.contains('translate-x-full') && window.innerWidth < 1024) {
        sidebar.classList.add('translate-x-full');
      }
    }

    document.getElementById('mobileMenuBtn').addEventListener('click', () => {
      document.getElementById('sidebar').classList.toggle('translate-x-full');
    });


    /* ----------------------------------------------------
       3. THEME CUSTOMIZER ENGINE
    ---------------------------------------------------- */
    function toggleThemeMenu() {
      document.getElementById('themeMenu').classList.toggle('hidden');
    }

    function setTheme(themeName) {
      document.body.classList.remove('theme-gold', 'theme-emerald', 'theme-cyberpunk');
      if (themeName !== 'default') {
        document.body.classList.add('theme-' + themeName);
      }
      document.getElementById('themeMenu').classList.add('hidden');
    }


    /* ----------------------------------------------------
       4. REAL-TIME AI VOICE & SPEECH ASSISTANT ENGINE
    ---------------------------------------------------- */
    let recognition = null;
    let isListening = false;
    const voiceWaveCanvas = document.getElementById('voiceWaveCanvas');
    const waveCtx = voiceWaveCanvas.getContext('2d');
    let waveAnimId = null;

    // Speech Synthesis setup
    const synth = window.speechSynthesis;

    // Initialize Web Speech Recognition
    if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      recognition = new SpeechRecognition();
      recognition.continuous = false;
      recognition.interimResults = false;

      recognition.onstart = function() {
        isListening = true;
        updateVoiceUI(true);
        startWaveAnimation();
      };

      recognition.onresult = function(event) {
        const transcript = event.results[0][0].transcript;
        addVoiceLog('تۆ', transcript);
        processAIVoiceResponse(transcript);
      };

      recognition.onerror = function() {
        updateVoiceUI(false);
        stopWaveAnimation();
      };

      recognition.onend = function() {
        isListening = false;
        updateVoiceUI(false);
        stopWaveAnimation();
      };
    }

    function toggleVoiceRecognition() {
      if (!recognition) {
        alert('وێبگەڕەکەت پشتگیری لە Web Speech API ناکات.');
        return;
      }
      if (isListening) {
        recognition.stop();
      } else {
        const lang = document.getElementById('voiceLangSelect').value;
        recognition.lang = lang;
        recognition.start();
      }
    }

    function updateVoiceUI(listening) {
      const btn = document.getElementById('micToggleBtn');
      const icon = document.getElementById('micIcon');
      const dot = document.getElementById('voiceStatusDot');
      const text = document.getElementById('voiceStatusText');
      const glow = document.getElementById('voiceGlowBg');

      if (listening) {
        btn.classList.add('scale-110');
        icon.className = 'fa-solid fa-microphone-slash text-rose-400';
        dot.className = 'w-2.5 h-2.5 rounded-full bg-cyan-400 animate-ping';
        text.innerText = 'گوێگرتن لە دەنگ...';
        glow.className = 'absolute w-96 h-96 rounded-full bg-cyan-400/30 blur-3xl transition-all duration-300';
      } else {
        btn.classList.remove('scale-110');
        icon.className = 'fa-solid fa-microphone text-cyan-400';
        dot.className = 'w-2.5 h-2.5 rounded-full bg-slate-500';
        text.innerText = 'ئامادەیە بۆ گوێگرتن';
        glow.className = 'absolute w-72 h-72 rounded-full bg-cyan-500/10 blur-3xl transition-all duration-500';
      }
    }

    function processAIVoiceResponse(userQuery) {
      // Dynamic Simulated AI Responses based on language/keywords
      let aiResponse = "من وەڵامی پرسیارەکەت دەدەمەوە: " + userQuery + ". S-SALWAN2006 AI هەمیشە ئامادەیە بۆ خزمەتکردنت.";
      
      if (userQuery.includes('سڵاو') || userQuery.includes('چۆنی')) {
        aiResponse = "سڵاو لە تۆش بەخێربێیت! من سستەمی دەنگی سەلوان ئێ ئایم، چۆن دەتوانم یارمەتیدەر بم؟";
      } else if (userQuery.includes('کێیت') || userQuery.includes('ناو')) {
        aiResponse = "من مۆدێلی زانیاری و دەنگی S-SALWAN2006 AI Universe م، دروستکراوم بۆ وەڵامدانەوەی خێرا.";
      }

      addVoiceLog('S-SALWAN AI', aiResponse);

      if (document.getElementById('autoSpeakToggle').checked) {
        speakText(aiResponse);
      }
    }

    function speakText(text) {
      if (!synth) return;
      synth.cancel(); // Stop current speech
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.rate = parseFloat(document.getElementById('speechRate').value);
      utterance.pitch = parseFloat(document.getElementById('speechPitch').value);
      utterance.lang = document.getElementById('voiceLangSelect').value;
      synth.speak(utterance);
    }

    function addVoiceLog(sender, text) {
      const log = document.getElementById('voiceChatLog');
      const isAI = sender.includes('SALWAN');
      log.innerHTML += `
        <div class="p-2.5 rounded-lg ${isAI ? 'bg-cyan-950/40 border border-cyan-500/30 text-cyan-200' : 'bg-slate-900 border border-slate-800 text-slate-300'}">
          <span class="font-bold ${isAI ? 'text-cyan-400' : 'text-amber-400'}">${sender}:</span> ${text}
        </div>
      `;
      log.scrollTop = log.scrollHeight;
    }

    function clearVoiceLog() {
      document.getElementById('voiceChatLog').innerHTML = '';
    }

    // Voice Visualizer Waves Canvas Loop
    function startWaveAnimation() {
      let step = 0;
      function renderWave() {
        waveCtx.clearRect(0, 0, voiceWaveCanvas.width, voiceWaveCanvas.height);
        waveCtx.beginPath();
        waveCtx.lineWidth = 3;
        waveCtx.strokeStyle = '#00f3ff';

        const width = voiceWaveCanvas.width;
        const height = voiceWaveCanvas.height;

        for (let x = 0; x < width; x += 5) {
          const y = Math.sin((x + step) * 0.05) * 20 + height / 2;
          if (x === 0) waveCtx.moveTo(x, y);
          else waveCtx.lineTo(x, y);
        }
        waveCtx.stroke();
        step += 2;
        waveAnimId = requestAnimationFrame(renderWave);
      }
      renderWave();
    }

    function stopWaveAnimation() {
      if (waveAnimId) cancelAnimationFrame(waveAnimId);
      waveCtx.clearRect(0, 0, voiceWaveCanvas.width, voiceWaveCanvas.height);
    }


    /* ----------------------------------------------------
       5. COMMUNITY Q&A SYSTEM DATA & ENGINE
    ---------------------------------------------------- */
    let questionsData = [
      {
        id: 1,
        author: 'ڕێبین عومەر',
        avatar: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=100&q=80',
        title: 'چۆن مۆدێلی S-SALWAN2006 بە بەراورد لەگەڵ مۆدێلە جیهانییەکان کاردەکات؟',
        body: 'سڵاو، دەمەوێت بزانم خێرایی و دروستی تێگەیشتن لە کوردی لەم سستەمە بە چ ڕێژەیەکە؟',
        upvotes: 42,
        time: '10 خولەک پێش ئێستا',
        answers: [
          {
            author: 'S-SALWAN AI Bot',
            isAI: true,
            text: 'مۆدێلی S-SALWAN2006 ت تایبەت کراوە بە زمانە ڕۆژهەڵاتییەکان و بە تایبەت کوردی سورانی، بە ڕێژەی 99% لە دەنگ و دەق تێدەگات.'
          }
        ]
      },
      {
        id: 2,
        author: 'دیلان ئەحمەد',
        avatar: 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=100&q=80',
        title: 'چۆن وێنەی 8K بە دروستی دروست بکەم لە تاقیگەکەدا؟',
        body: 'کاتێک Prompt ئینگلیزی دەنووسم ئەنجامەکەی زۆر باشترە، ئایا دەتوانم کوردی بەکاربهێنم؟',
        upvotes: 28,
        time: '1 کاتژمێر پێش ئێستا',
        answers: [
          {
            author: 'سەرکەوت زانستی',
            isAI: false,
            text: 'بەڵێ سستەمەکە هەردوو زمان وەردەگرێت بەڵام وەسفی ورد بدە.'
          }
        ]
      }
    ];

    function renderQuestions() {
      const container = document.getElementById('questionsContainer');
      container.innerHTML = questionsData.map(q => `
        <div class="glass-panel p-5 rounded-2xl space-y-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <img src="${q.avatar}" class="w-8 h-8 rounded-full" alt="User">
              <div>
                <div class="text-xs font-bold text-white">${q.author}</div>
                <div class="text-[10px] text-slate-400">${q.time}</div>
              </div>
            </div>
            <button onclick="upvoteQuestion(${q.id})" class="flex items-center gap-1 px-3 py-1 rounded-xl bg-slate-900 border border-slate-700 text-xs text-amber-400 font-bold hover:bg-amber-500/10">
              <i class="fa-solid fa-caret-up"></i> ${q.upvotes}
            </button>
          </div>

          <h3 class="text-base font-bold text-white">${q.title}</h3>
          <p class="text-xs text-slate-300 leading-relaxed">${q.body}</p>

          <!-- Answers Section -->
          <div class="pt-3 border-t border-slate-800 space-y-2">
            ${q.answers.map(a => `
              <div class="p-3 rounded-xl ${a.isAI ? 'bg-cyan-950/30 border border-cyan-500/30' : 'bg-slate-900'} space-y-1">
                <div class="text-xs font-bold ${a.isAI ? 'text-cyan-400' : 'text-slate-200'} flex items-center gap-1">
                  ${a.isAI ? '<i class="fa-solid fa-robot"></i>' : ''} ${a.author}
                </div>
                <div class="text-xs text-slate-300">${a.text}</div>
              </div>
            `).join('')}
          </div>
        </div>
      `).join('');
    }

    function upvoteQuestion(id) {
      const q = questionsData.find(item => item.id === id);
      if (q) {
        q.upvotes++;
        renderQuestions();
      }
    }

    function openAskQuestionModal() {
      document.getElementById('askModal').classList.remove('hidden');
    }

    function closeAskQuestionModal() {
      document.getElementById('askModal').classList.add('hidden');
    }

    function submitNewQuestion() {
      const title = document.getElementById('newQuestionTitle').value;
      const body = document.getElementById('newQuestionBody').value;

      if (!title) return;

      const newQ = {
        id: Date.now(),
        author: 'سەلوان ئەحمەد',
        avatar: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&q=80',
        title: title,
        body: body,
        upvotes: 1,
        time: 'ئێستا',
        answers: [
          {
            author: 'S-SALWAN AI Instant Bot',
            isAI: true,
            text: 'سوپاس بۆ پرسیارەکەت! سستەمی زیرەک بە شێوەیەکی خۆکارانە شیکاری بۆ پرسیارەکەت دەکات.'
          }
        ]
      };

      questionsData.unshift(newQ);
      renderQuestions();
      closeAskQuestionModal();
      document.getElementById('newQuestionTitle').value = '';
      document.getElementById('newQuestionBody').value = '';
    }


    /* ----------------------------------------------------
       6. EXPANDED ULTRA-HD GALLERY DATA & LIGHTBOX
    ---------------------------------------------------- */
    const galleryItems = [
      {
        id: 1,
        category: 'cars',
        title: 'Bugatti Tourbillon Hypercar',
        desc: 'سوپەرکاری دەگمەنی بزوێنەری V16 لەگەڵ تەکنەلۆجیای هایبرید.',
        img: 'https://images.unsplash.com/photo-1617814076367-b759c7d7e738?auto=format&fit=crop&w=800&q=80',
        likes: 340
      },
      {
        id: 2,
        category: 'cars',
        title: 'Futuristic Electric Supercar',
        desc: 'دیزاینی سایبەر و بزوێنەری کارەبایی ڕەها.',
        img: 'https://images.unsplash.com/photo-1544829099-b9a0c07fad1a?auto=format&fit=crop&w=800&q=80',
        likes: 210
      },
      {
        id: 3,
        category: 'culture',
        title: 'جلوبەرگی ڕەسەنی کوردی',
        desc: 'جوانی و ڕازاوەیی ڕەنگەکانی کەلتور و جلی کوردی.',
        img: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=800&q=80',
        likes: 580
      },
      {
        id: 4,
        category: 'nature',
        title: 'دار و درەختی بەتەمەن',
        desc: 'دارستانی سەوز و سروشتی ئەفسووناوی چیاکانی کوردستان.',
        img: 'https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=800&q=80',
        likes: 410
      },
      {
        id: 5,
        category: 'space',
        title: 'تەلەس کۆپی James Webb & گەردوون',
        desc: 'وێنەی درەوشاوەی ئەستێرەکان و گەلەستێرەی دوور.',
        img: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=800&q=80',
        likes: 620
      },
      {
        id: 6,
        category: 'nature',
        title: 'گژوگیا و گوڵی کوێستان',
        desc: 'گوڵە کێوییەکانی وەرزی بەهار.',
        img: 'https://images.unsplash.com/photo-1501004318641-b39e6451bec6?auto=format&fit=crop&w=800&q=80',
        likes: 195
      }
    ];

    function renderGallery(filter = 'all') {
      const grid = document.getElementById('galleryGrid');
      const filtered = filter === 'all' ? galleryItems : galleryItems.filter(i => i.category === filter);

      grid.innerHTML = filtered.map(item => `
        <div onclick="openLightbox(${item.id})" class="glass-card rounded-2xl overflow-hidden cursor-pointer group">
          <div class="relative h-48 overflow-hidden">
            <img src="${item.img}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="${item.title}">
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent opacity-80"></div>
            <span class="absolute bottom-2 right-2 px-2 py-0.5 rounded bg-black/60 text-[10px] text-cyan-300 font-bold uppercase">${item.category}</span>
          </div>
          <div class="p-3">
            <h4 class="text-xs font-bold text-white truncate">${item.title}</h4>
            <div class="flex items-center justify-between mt-2 text-[10px] text-slate-400">
              <span><i class="fa-solid fa-heart text-rose-500"></i> ${item.likes}</span>
              <span class="text-cyan-400 font-bold">بینین <i class="fa-solid fa-expand"></i></span>
            </div>
          </div>
        </div>
      `).join('');
    }

    function filterGallery(cat) {
      renderGallery(cat);
    }

    let activeLightboxItem = null;
    function openLightbox(id) {
      activeLightboxItem = galleryItems.find(i => i.id === id);
      if (!activeLightboxItem) return;

      document.getElementById('lightboxImg').src = activeLightboxItem.img;
      document.getElementById('lightboxTitle').innerText = activeLightboxItem.title;
      document.getElementById('lightboxDesc').innerText = activeLightboxItem.desc;
      document.getElementById('lightboxBadge').innerText = activeLightboxItem.category.toUpperCase();
      document.getElementById('lightboxLikes').innerText = activeLightboxItem.likes;

      document.getElementById('lightboxModal').classList.remove('hidden');
    }

    function closeLightbox() {
      document.getElementById('lightboxModal').classList.add('hidden');
    }

    function simulateLike() {
      if (activeLightboxItem) {
        activeLightboxItem.likes++;
        document.getElementById('lightboxLikes').innerText = activeLightboxItem.likes;
        renderGallery();
      }
    }

    function downloadImageSim() {
      alert('داگرتنی وێنەی Ultra-HD دەستی پێکرد...');
    }


    /* ----------------------------------------------------
       7. SMART SEARCH ENGINE SIMULATION
    ---------------------------------------------------- */
    function performSearch() {
      const q = document.getElementById('searchInput').value;
      if (!q) return;

      const area = document.getElementById('searchResultsArea');
      const summary = document.getElementById('searchSummaryText');
      const grid = document.getElementById('searchCardsGrid');

      area.classList.remove('hidden');
      summary.innerText = `شیکاری AI بۆ (${q}): بەپێی نوێترین داتاکانی گەڕان، ئەم بابەتە یەکێکە لە تەوەرە سەرەکییەکان لە بوارەکەی خۆیدا و سەرچاوەی جۆراوجۆری زانستی لەسەر بەردەستە.`;

      grid.innerHTML = `
        <div class="glass-panel p-4 rounded-xl space-y-2">
          <h4 class="text-xs font-bold text-cyan-400">زانیاری سەرەکی</h4>
          <p class="text-xs text-slate-300">پوختەی سەرچاوە متمانەپێکراوەکانی گەڕانی زیرەک لەگەڵ تێگەیشتنی نوێ.</p>
        </div>
        <div class="glass-panel p-4 rounded-xl space-y-2">
          <h4 class="text-xs font-bold text-amber-400">تەوەرە پەیوەندیدارەکان</h4>
          <p class="text-xs text-slate-300">بابەتە بەستراوەکان و شیکاری زیاتر لە سەرچاوە جیهانییەکان.</p>
        </div>
      `;
    }

    function quickSearch(text) {
      document.getElementById('searchInput').value = text;
      performSearch();
    }


    /* ----------------------------------------------------
       8. AI IMAGE STUDIO ENGINE
    ---------------------------------------------------- */
    function generateAIStudioImage() {
      const prompt = document.getElementById('imagePromptInput').value;
      if (!prompt) return;

      const placeholder = document.getElementById('imageStudioPlaceholder');
      const loading = document.getElementById('imageStudioLoading');
      const result = document.getElementById('imageStudioResult');

      placeholder.classList.add('hidden');
      result.classList.add('hidden');
      loading.classList.remove('hidden');
      loading.classList.add('flex');

      setTimeout(() => {
        loading.classList.add('hidden');
        loading.classList.remove('flex');
        result.classList.remove('hidden');

        // Dynamic placeholder based on prompt style
        document.getElementById('generatedImageTag').src = 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=1000&q=80';
      }, 2500);
    }

    function downloadStudioImage() {
      alert('داگرتنی وێنەی AI Studio سەرکەوتوو بوو.');
    }


    /* ----------------------------------------------------
       9. KURDISH POETRY HUB DATA & RENDER
    ---------------------------------------------------- */
    const poemsData = [
      {
        poet: 'نالی',
        title: 'خاڵی ڕووت',
        lines: ['مەست بووم لە سەیری خاڵی ڕووت', 'عاشق بووم لە چاوی جادووت']
      },
      {
        poet: 'مەحوی',
        title: 'شەوی تاری تاریکی',
        lines: ['لە دەوری دەستی تۆدا خول دەخۆم', 'هەتا ماوم فیدای نازی تۆ دەبم']
      },
      {
        poet: 'شێرکۆ بێکەس',
        title: 'دەنگی باران',
        lines: ['من کە باران دەبارێ', 'بیری چاوەکانت دەکەم...']
      }
    ];

    function renderPoetry() {
      const container = document.getElementById('poetryContainer');
      container.innerHTML = poemsData.map(p => `
        <div class="glass-panel p-5 rounded-2xl space-y-3 border-r-4 border-amber-400">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-amber-400">${p.poet}</span>
            <span class="text-[10px] text-slate-400">هۆنراوەی کلاسیک</span>
          </div>
          <h3 class="text-base font-bold text-white">${p.title}</h3>
          <div class="space-y-1 text-xs text-slate-300 italic">
            ${p.lines.map(l => `<p>"${l}"</p>`).join('')}
          </div>
        </div>
      `).join('');
    }


    /* ----------------------------------------------------
       10. ANALYTICS CHART.JS RENDER
    ---------------------------------------------------- */
    function initCharts() {
      const ctx1 = document.getElementById('trafficChart').getContext('2d');
      new Chart(ctx1, {
        type: 'line',
        data: {
          labels: ['شەممە', 'یەکشەممە', 'دووشەممە', 'سێشەممە', 'چوارشەممە', 'پێنجشەممە', 'جومعە'],
          datasets: [{
            label: 'سەردانکەرانی ڕاستەوخۆ',
            data: [1200, 1900, 3000, 5000, 4200, 6800, 9500],
            borderColor: '#00f3ff',
            backgroundColor: 'rgba(0, 243, 255, 0.1)',
            fill: true,
            tension: 0.4
          }]
        },
        options: {
          responsive: true,
          plugins: { legend: { display: false } },
          scales: {
            x: { ticks: { color: '#94a3b8' } },
            y: { ticks: { color: '#94a3b8' } }
          }
        }
      });

      const ctx2 = document.getElementById('modelsChart').getContext('2d');
      new Chart(ctx2, {
        type: 'doughnut',
        data: {
          labels: ['S-SALWAN Voice', 'AI Image Studio', 'Smart Search', 'Q&A Community'],
          datasets: [{
            data: [45, 25, 20, 10],
            backgroundColor: ['#00f3ff', '#a855f7', '#10b981', '#ffd700']
          }]
        },
        options: {
          responsive: true,
          plugins: { legend: { labels: { color: '#94a3b8' } } }
        }
      });
    }


    /* ----------------------------------------------------
       11. AUTH MODAL & PROFILE UTILS
    ---------------------------------------------------- */
    function openAuthModal() {
      document.getElementById('authModal').classList.remove('hidden');
    }
    function closeAuthModal() {
      document.getElementById('authModal').classList.add('hidden');
    }
    function copyApiKey() {
      alert('کلیلی API بە سەرکەوتوویی کۆپی کرا.');
    }


    /* ----------------------------------------------------
       INITIALIZATION ON PAGE LOAD
    ---------------------------------------------------- */
    window.onload = function() {
      renderQuestions();
      renderGallery('all');
      renderPoetry();
      initCharts();
    };
  </script>
</body>
</html>